@article{takeuchiMultilevelSelectionModels2009,
  title = {Multilevel Selection in Models of Prebiotic Evolution {{II}}: A Direct Comparison of Compartmentalization and Spatial Self-Organization},
  shorttitle = {Multilevel Selection in Models of Prebiotic Evolution {{II}}},
  author = {Takeuchi, Nobuto and Hogeweg, Paulien},
  date = {2009-10},
  journaltitle = {PLoS computational biology},
  shortjournal = {PLoS Comput Biol},
  volume = {5},
  number = {10},
  eprint = {19834556},
  eprinttype = {pmid},
  pages = {e1000542},
  issn = {1553-7358},
  doi = {10.1371/journal.pcbi.1000542},
  abstract = {Multilevel selection has been indicated as an essential factor for the evolution of complexity in interacting RNA-like replicator systems. There are two types of multilevel selection mechanisms: implicit and explicit. For implicit multilevel selection, spatial self-organization of replicator populations has been suggested, which leads to higher level selection among emergent mesoscopic spatial patterns (traveling waves). For explicit multilevel selection, compartmentalization of replicators by vesicles has been suggested, which leads to higher level evolutionary dynamics among explicitly imposed mesoscopic entities (protocells). Historically, these mechanisms have been given separate consideration for the interests on its own. Here, we make a direct comparison between spatial self-organization and compartmentalization in simulated RNA-like replicator systems. Firstly, we show that both mechanisms achieve the macroscopic stability of a replicator system through the evolutionary dynamics on mesoscopic entities that counteract that of microscopic entities. Secondly, we show that a striking difference exists between the two mechanisms regarding their possible influence on the long-term evolutionary dynamics, which happens under an emergent trade-off situation arising from the multilevel selection. The difference is explained in terms of the difference in the stability between self-organized mesoscopic entities and externally imposed mesoscopic entities. Thirdly, we show that a sharp transition happens in the long-term evolutionary dynamics of the compartmentalized system as a function of replicator mutation rate. Fourthly, the results imply that spatial self-organization can allow the evolution of stable folding in parasitic replicators without any specific functionality in the folding itself. Finally, the results are discussed in relation to the experimental synthesis of chemical Darwinian systems and to the multilevel selection theory of evolutionary biology in general. To conclude, novel evolutionary directions can emerge through interactions between the evolutionary dynamics on multiple levels of organization. Different multilevel selection mechanisms can produce a difference in the long-term evolutionary trend of identical microscopic entities.},
  langid = {english},
  pmcid = {PMC2757730},
  keywords = {Biological Evolution,Models Theoretical},
  file = {C:\Users\rutge\Zotero\storage\AJ698ZV4\Takeuchi and Hogeweg - 2009 - Multilevel selection in models of prebiotic evolut.pdf}
}

@unpublished{takeuchiScalingLawsMultilevel2020,
  title = {Scaling Laws of Multilevel Selection: A Striking Difference between Continuous-Trait and Binary-Trait Models},
  shorttitle = {Scaling Laws of Multilevel Selection},
  author = {Takeuchi, Nobuto and Mitarai, Namiko and Kaneko, Kunihiko},
  date = {2020-06-29},
  eprint = {2005.04421},
  eprinttype = {arxiv},
  eprintclass = {cond-mat, physics:physics, q-bio},
  url = {http://arxiv.org/abs/2005.04421},
  urldate = {2020-07-13},
  abstract = {The evolution of altruism is a key step in major evolutionary transitions. Previous theoretical studies often assume that individuals adopt one of two possible strategies, altruism or selfishness. In reality, however, cooperative strategies are likely to constitute a continuum between selfishness and altruism. Here, we investigate how such continuous variation affects the evolution of altruism through multilevel selection. In our model, altruism is favoured by selection among groups, whereas selfishness is favoured by selection within groups. We determine how evolution depends on the number of replicators per group (\$N\$), mutation rate (\$m\$), and selection strength (\$s\$). We find that decreasing \$N\$ or \$m\$ promotes evolution toward altruism, and if this evolution is exactly balanced out by evolution towards selfishness, \$N\$ and \$m\$ satisfy a scaling relation \$N\textbackslash,\textbackslash propto\textbackslash, m\textasciicircum\{-\textbackslash alpha\}\$ such that evolution becomes increasingly independent of \$m\$ as \$s\$ decreases (i.e., \$\textbackslash alpha\textbackslash downarrow0\$ as \$s\textbackslash downarrow0\$). This relation markedly differs from that predicted by a binary-trait model, where evolution becomes increasingly dependent on \$m\$ as \$s\$ decreases. We show that this difference is caused by the assumption implicit in binary-trait models that mutation causes convergent evolution even in the absence of selection. Our study illustrates how considering quantitative variation can be important for understanding the evolution of altruism during major evolutionary transitions.},
  keywords = {Condensed Matter - Soft Condensed Matter,Physics - Biological Physics,Quantitative Biology - Populations and Evolution},
  file = {C:\Users\rutge\Zotero\storage\HTRY9I76\Takeuchi et al. - 2020 - Scaling laws of multilevel selection a striking d.pdf}
}

