  author = {Prudhomme, Marc and Berge, Mathieu and Martin, Bernard and Polard, Patrice},
  date = {2016-06-29},
  journaltitle = {PLOS Genetics},
  shortjournal = {PLOS Genetics},
  volume = {12},
  number = {6},
  pages = {e1006113},
  issn = {1553-7404},
  doi = {10.1371/journal.pgen.1006113},
  url = {http://journals.plos.org/plosgenetics/article?id=10.1371/journal.pgen.1006113},
  urldate = {2017-01-26},
  abstract = {Author Summary Development of competence for genetic transformation by cultures of pneumococcal cells has been considered till now as a classic example of quorum sensing, whereby a culture attaining a sufficient cell density detects a diffusible signaling molecule (in this case, Competence-Stimulating Peptide (CSP)) and switches en masse to a distinct physiological state. We find that the competence shift is dictated not by cell density but by growth for a time allowing emergence of a competence-initiator sub-population, and spreads by transmission of CSP through cell contact. This behaviour reflects the survival benefits of allowing subsets of the population to respond to environmental stress by generating signalling capacity, which prepares the entire population for a rapid and appropriate response to threatening conditions.},
  keywords = {Antibiotics,Cellular stress responses,DNA transcription,Genetic transformation,Luciferin,Operons,Pneumococcus,Population density},
