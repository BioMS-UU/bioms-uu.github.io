@article{fletcherSimpleGeneralExplanation2009,
  title = {A Simple and General Explanation for the Evolution of Altruism},
  author = {Fletcher, Jeffrey A. and Doebeli, Michael},
  date = {2009-01-07},
  journaltitle = {Proceedings of the Royal Society of London B: Biological Sciences},
  volume = {276},
  number = {1654},
  eprint = {18765343},
