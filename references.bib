@article{scottInterdependenceCellGrowth2010,
  title = {Interdependence of Cell Growth and Gene Expression: Origins and Consequences},
  author = {Scott, Matthew and Gunderson, Carl W and Mateescu, Eduard M and Zhang, Zhongge and Hwa, Terence},
  date = {2010-11},
