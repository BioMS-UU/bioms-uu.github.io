@article{brookfield1998,
  title = {Quorum {{Sensing}} and {{Group Selection}}},
  author = {Brookfield, J. F. Y.},
  date = {1998-10-01},
  journaltitle = {Evolution},
  shortjournal = {Evolution},
  volume = {52},
  number = {5},
  eprint = {2411295},
