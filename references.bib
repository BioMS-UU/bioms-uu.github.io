@article{sharmaModellingMicrobialCommunities2019,
  title = {Modelling Microbial Communities Using Biochemical Resource Allocation Analysis},
  author = {Sharma, Suraj and Steuer, Ralf},
  date = {2019-11},
  journaltitle = {Journal of The Royal Society Interface},
  shortjournal = {J. R. Soc. Interface.},
  volume = {16},
