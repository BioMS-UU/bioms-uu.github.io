@article{frankNaturalSelectionVII2013,
  title = {Natural Selection. {{VII}}. {{History}} and Interpretation of Kin Selection Theory},
  author = {Frank, S. A.},
  date = {2013-06},
  journaltitle = {Journal of Evolutionary Biology},
  shortjournal = {J. Evol. Biol.},
  volume = {26},
  number = {6},
