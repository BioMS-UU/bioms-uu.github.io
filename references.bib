  author = {Sheinman, Michael and Arkhipova, Ksenia and Arndt, Peter F and Dutilh, Bas E and Hermsen, Rutger and Massip, Florian},
  editor = {Neher, Richard A and Storz, Gisela and Neher, Richard A},
