  volume = {116},
  number = {5},
  pages = {058101},
  doi = {10.1103/PhysRevLett.116.058101},
  url = {http://link.aps.org/doi/10.1103/PhysRevLett.116.058101},
  urldate = {2016-06-08},
  abstract = {Biochemical processes are inherently stochastic, creating molecular fluctuations in otherwise identical cells. Such “noise” is widespread but has proven difficult to analyze because most systems are sparsely characterized at the single cell level and because nonlinear stochastic models are analytically intractable. Here, we exactly relate average abundances, lifetimes, step sizes, and covariances for any pair of components in complex stochastic reaction systems even when the dynamics of other components are left unspecified. Using basic mathematical inequalities, we then establish bounds for whole classes of systems. These bounds highlight fundamental trade-offs that show how efficient assembly processes must invariably exhibit large fluctuations in subunit levels and how eliminating fluctuations in one cellular component requires creating heterogeneity in another.},
  file = {C\:\\Users\\rutge\\Zotero\\storage\\5QC24SGU\\Hilfinger_et_al_2016_Physical_Review_Letters.pdf;C\:\\Users\\rutge\\Zotero\\storage\\H28R5GX5\\PhysRevLett.116.html}
}

