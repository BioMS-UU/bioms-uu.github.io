  doi = {http://dx.doi.org/10.3998/ptb.6959004.0002.002},
  url = {http://hdl.handle.net/2027/spo.6959004.0002.002},
  abstract = {The statistical interpretation of the Theory of Natural Selection claims that natural selection and drift are statistical features of mathematical aggregates of individual-level events. Natural selection and drift are not themselves causes. The statistical interpretation is motivated by a metaphysical conception of individual priority. Recently, Millstein, Skipper, and Dietrich (2009) have argued (a) that natural selection and drift are physical processes, and (b) that the statistical interpretation rests on a misconception of the role of mathematics in biology. Both theses are contested.},
