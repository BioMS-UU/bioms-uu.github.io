@article{roseAnalysisExperimentalTransition2020,
  title = {Analysis of an Experimental Transition in Individuality Challenges the Need to Assign Traits to Levels},
  author = {Rose, Caroline J. and Hammerschmidt, Katrin and Rainey, Paul B.},
  date = {2020-03-04},
  journaltitle = {bioRxiv},
  pages = {2020.03.02.973792},
  publisher = {Cold Spring Harbor Laboratory},
  doi = {10.1101/2020.03.02.973792},
  url = {https://www.biorxiv.org/content/10.1101/2020.03.02.973792v1},
  urldate = {2020-03-10},
  abstract = {{$<$}p{$>$}A major evolutionary transition in individuality, at any level of the biological hierarchy, occurs when groups become capable of participating in Darwinian processes as units of selection. Identifying transitions in individuality can be problematic because apparent selection at one level of the biological hierarchy may be a by-product of selection occurring at another level. Here we discuss various approaches to this ′levels-of-selection′ problem, drawing attention to the futility of designating traits to hierarchical levels prior to determining the level of selection. While individuals can exhibit traits that are maintained by selection at any level in the biological hierarchy, terms synonymous with ′collective (group) trait′ or ′particle trait′ are often applied prematurely. We argue that traits should not be assigned \emph{a priori } to a hierarchical level, but may respond to selection at different levels depending on environmental conditions. This point is illustrated by an experiment in which groups of the bacterium \emph{Pseudomonas fluorescens } reproduced via life cycles involving soma- and germline-like phases. The rate of transition between the two cell types was a focus of selection, and might be regarded as a property of groups, cells, or even genes. Philosophical analyses reveal that this trait evolved to be higher in one treatment as a result of its emergent relation to group fitness (contributing to the evolution of individuality), and lower in another treatment because of cell-level selection. An \emph{a priori } designation of transition rate as either a ′group trait′ or a ′cell trait′ may have masked the true level of selection.{$<$}/p{$>$}},
  langid = {english},
  file = {C\:\\Users\\rutge\\Zotero\\storage\\9NGZACG2\\Rose et al. - 2020 - Analysis of an experimental transition in individu.pdf;C\:\\Users\\rutge\\Zotero\\storage\\GEYFTANG\\2020.03.02.html}
}

