@article{guessousInheritanceSecretedEnzymes,
  title = {Inheritance of Secreted Enzymes Enables the Sustained Growth of Dispersing Marine Bacteria on Chitin Particles},
  author = {Guessous, Ghita and Patsalo, Vadim and Balakrishnan, Rohan and Ça, Tolga and Hwa, Terence},
  pages = {29},
  abstract = {The growth of marine bacterium Vibrio sp. 1A01 was quantitatively characterized with chitin particles as the sole source of carbon and nitrogen. Despite the heterogeneous nature of the culture due to chitin’s insolubility, simple exponential dynamics emerged with two co-existing subpopulations: a minority replicating on the particles and a nonreplicating majority which was planktonic. This partition of the biomass resulted from a high cell detachment rate from particles. The continual exponential growth of both subpopulations despite high detachment was enabled by the enrichment of extra-cellular chitinases on particles. The inheritance of these chitinases, secreted by departing cells, allows the resident subpopulation to sustain high dispersal rates while maintaining growth. This provides a novel mechanism resolving the tradeoff between growth and dispersal, with relevance to chitin utilization by marine heterotrophs whose survival in the ocean requires not only growth on their current habitat but also the search for new ones.},
  langid = {english},
  keywords = {To Read},
  file = {C\:\\Users\\rutge\\Zotero\\storage\\4A2DN97P\\MS v 4.0- Supplement.pdf;C\:\\Users\\rutge\\Zotero\\storage\\X8XUPHX4\\Guessous et al. - Inheritance of secreted enzymes enables the sustai.pdf}
