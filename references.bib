@article{hamilton1990,
  title = {Sexual Reproduction as an Adaptation to Resist Parasites (a Review)},
  author = {Hamilton, W. D. and Axelrod, R. and Tanese, R.},
  date = {1990-05-01},
  journaltitle = {Proceedings of the National Academy of Sciences},
  shortjournal = {PNAS},
  volume = {87},
