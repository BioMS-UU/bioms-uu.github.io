@article{gardnerRelationMultilocusPopulation2007,
  title = {The {{Relation}} between {{Multilocus Population Genetics}} and {{Social Evolution Theory}}.},
  author = {Gardner, Andy and West, Stuart~A. and Barton, Nicholas~H.},
  date = {2007-02},
  journaltitle = {The American Naturalist},
  volume = {169},
