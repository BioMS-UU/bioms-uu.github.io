  author = {family=Wageningen, given=Sake, prefix=van, useprefix=true and Kemmeren, Patrick and Lijnzaad, Philip and Margaritis, Thanasis and Benschop, Joris J. and family=Castro, given=Inês J., prefix=de, useprefix=true and family=Leenen, given=Dik, prefix=van, useprefix=true and Groot Koerkamp, Marian J. A. and Ko, Cheuk W. and Miles, Antony J. and Brabers, Nathalie and Brok, Mariel O. and Lenstra, Tineke L. and Fiedler, Dorothea and Fokkens, Like and Aldecoa, Rodrigo and Apweiler, Eva and Taliadouros, Virginia and Sameith, Katrin and family=Pasch, given=Loes A. L., prefix=van de, useprefix=true and family=Hooff, given=Sander R., prefix=van, useprefix=true and Bakker, Linda V. and Krogan, Nevan J. and Snel, Berend and Holstege, Frank C. P.},
  date = {2010-12-10},
  journaltitle = {Cell},
  shortjournal = {Cell},
  volume = {143},
  number = {6},
  pages = {991--1004},
  issn = {0092-8674},
  doi = {10.1016/j.cell.2010.11.021},
  url = {http://www.sciencedirect.com/science/article/pii/S0092867410013012},
  urldate = {2015-02-27},
  abstract = {Summary To understand relationships between phosphorylation-based signaling pathways, we analyzed 150 deletion mutants of protein kinases and phosphatases in S. cerevisiae using DNA microarrays. Downstream changes in gene expression were treated as a phenotypic readout. Double mutants with synthetic genetic interactions were included to investigate genetic buffering relationships such as redundancy. Three types of genetic buffering relationships are identified: mixed epistasis, complete redundancy, and quantitative redundancy. In mixed epistasis, the most common buffering relationship, different gene sets respond in different epistatic ways. Mixed epistasis arises from pairs of regulators that have only partial overlap in function and that are coupled by additional regulatory links such as repression of one by the other. Such regulatory modules confer the ability to control different combinations of processes depending on condition or context. These properties likely contribute to the evolutionary maintenance of paralogs and indicate a way in which signaling pathways connect for multiprocess control.},
  keywords = {_tablet,CELLBIO,SIGNALING},
  file = {C\:\\Users\\rutge\\Zotero\\storage\\JHHEJWIB\\van_Wageningen_et_al_2010_Cell.pdf;C\:\\Users\\rutge\\Zotero\\storage\\35REGQN2\\S0092867410013012.html}
}

