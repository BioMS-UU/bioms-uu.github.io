@article{koirala2015,
  title = {Reciprocal Regulation of {{L-arabinose}} and {{D-xylose}} Metabolism in {{Escherichia}} Coli},
  author = {Koirala, Santosh and Wang, Xiaoyi and Rao, Christopher V.},
  date = {2015-11-02},
  journaltitle = {Journal of Bacteriology},
  shortjournal = {J. Bacteriol.},
  eprint = {26527647},
  eprinttype = {pmid},
  pages = {JB.00709-15},
  issn = {0021-9193, 1098-5530},
  doi = {10.1128/JB.00709-15},
  url = {http://jb.asm.org/content/early/2015/10/27/JB.00709-15},
  urldate = {2016-05-23},
  abstract = {Glucose is known to inhibit the transport and metabolism of many sugars in Escherichia coli. This mechanism leads to its preferential consumption. Far less is known about the preferential utilization of non-glucose sugars in E. coli. One exception is L-arabinose and D-xylose. Previous studies have shown that L-arabinose inhibits D-xylose metabolism in Escherichia coli. This repression results from L-arabinose-bound AraC binding to the promoter of the D-xylose metabolic genes and inhibiting their expression. This mechanism, however, has not been explored in single cells. Both the L-arabinose and D-xylose utilization systems are known to exhibit a bimodal induction response to their cognate sugar, where mixed populations of cells either expressing the metabolic genes or not are observed at intermediate sugar concentrations. This suggests that L-arabinose can only inhibit D-xylose metabolism in L-arabinose-induced cells. To understand how crosstalk between these systems affects their response, we investigated E. coli during growth on mixtures of L-arabinose and D-xylose at single-cell resolution. Our results show that mixed, multimodal populations of L-arabinose and D-xylose-induced cells occur at intermediate sugar concentrations. We also found that D-xylose can inhibit the expression of the L-arabinose metabolic genes and that this repression is due to XylR. These results demonstrate that a strict hierarchy does not exist between L-arabinose and D-xylose as previously thought. They may also aid in the design of E. coli strains capable of simultaneous sugar consumption. IMPORTANCE Glucose, D-xylose and L-arabinose are the most abundant sugars in plant biomass. Developing efficient fermentation processes that convert these sugars into chemicals and fuels will require strains capable of co-utilizing these sugars. Glucose has long been known to represses the expression of the L-arabinose and D-xylose metabolic genes in Escherichia coli. Recent studies found that L-arabinose also represses the expression of the D-xylose metabolic genes. In the present study, we found that D-xylose also represses the expression of the L-arabinose metabolic genes, leading to mixed populations of cells capable of utilizing L-arabinose and D-xylose. These results further our understanding of mixed-sugar utilization and may aid in strain design.},
