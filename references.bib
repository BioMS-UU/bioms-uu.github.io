@article{bowsherIdentifyingSourcesVariation2012,
  title = {Identifying Sources of Variation and the Flow of Information in Biochemical Networks},
  author = {Bowsher, Clive G. and Swain, Peter S.},
  date = {2012-05-15},
  journaltitle = {Proceedings of the National Academy of Sciences},
  shortjournal = {PNAS},
  volume = {109},
