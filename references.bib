@article{paulssonModelsStochasticGene2005,
  title = {Models of Stochastic Gene Expression},
  author = {Paulsson, Johan},
  date = {2005-06},
  journaltitle = {Physics of Life Reviews},
  shortjournal = {Physics of Life Reviews},
  volume = {2},
  number = {2},
  pages = {157--175},
  issn = {1571-0645},
  doi = {10.1016/j.plrev.2005.03.003},
  url = {http://www.sciencedirect.com/science/article/pii/S1571064505000138},
  urldate = {2016-05-03},
  abstract = {Gene expression is an inherently stochastic process: Genes are activated and inactivated by random association and dissociation events, transcription is typically rare, and many proteins are present in low numbers per cell. The last few years have seen an explosion in the stochastic modeling of these processes, predicting protein fluctuations in terms of the frequencies of the probabilistic events. Here I discuss commonalities between theoretical descriptions, focusing on a gene-mRNA-protein model that includes most published studies as special cases. I also show how expression bursts can be explained as simplistic time-averaging, and how generic approximations can allow for concrete interpretations without requiring concrete assumptions. Measures and nomenclature are discussed to some extent and the modeling literature is briefly reviewed.},
  keywords = {Noise,Protein,Stochastic gene expression},
  file = {C\:\\Users\\rutge\\Zotero\\storage\\KQGEMC4Q\\Paulsson_2005_Physics_of_Life_Reviews.pdf;C\:\\Users\\rutge\\Zotero\\storage\\EMVZKRJJ\\S1571064505000138.html}
}

