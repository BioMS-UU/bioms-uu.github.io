@article{geva-zatorsky2010,
  title = {Protein {{Dynamics}} in {{Drug Combinations}}: A {{Linear Superposition}} of {{Individual-Drug Responses}}},
  shorttitle = {Protein {{Dynamics}} in {{Drug Combinations}}},
  author = {Geva-Zatorsky, Naama and Dekel, Erez and Cohen, Ariel A. and Danon, Tamar and Cohen, Lydia and Alon, Uri},
  date = {2010-05-03},
  journaltitle = {Cell},
  volume = {140},
  number = {5},
  eprint = {20211134},
