@article{kussellPhenotypicDiversityPopulation2005,
  title = {Phenotypic {{Diversity}}, {{Population Growth}}, and {{Information}} in {{Fluctuating Environments}}},
  author = {Kussell, Edo and Leibler, Stanislas},
  date = {2005-09-23},
  journaltitle = {Science},
  volume = {309},
  number = {5743},
  eprint = {16123265},
  eprinttype = {pmid},
  pages = {2075--2078},
  issn = {0036-8075, 1095-9203},
  doi = {10.1126/science.1114383},
  url = {https://science.sciencemag.org/content/309/5743/2075},
  urldate = {2019-04-12},
  abstract = {Organisms in fluctuating environments must constantly adapt their behavior to survive. In clonal populations, this may be achieved through sensing followed by response or through the generation of diversity by stochastic phenotype switching. Here we show that stochastic switching can be favored over sensing when the environment changes infrequently. The optimal switching rates then mimic the statistics of environmental changes. We derive a relation between the long-term growth rate of the organism and the information available about its fluctuating environment. If their environments change rarely, the best strategy for bacteria is to switch phenotypes infrequently; if change is common, it is better to adapt accordingly. If their environments change rarely, the best strategy for bacteria is to switch phenotypes infrequently; if change is common, it is better to adapt accordingly.},
  langid = {english},
