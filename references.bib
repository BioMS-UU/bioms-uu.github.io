@article{nowak2010,
  title = {The Evolution of Eusociality},
  author = {Nowak, Martin A. and Tarnita, Corina E. and Wilson, Edward O.},
  date = {2010-08-26},
  journaltitle = {Nature},
  shortjournal = {Nature},
